From 55b10d3fdb7bfb9a73312405ff42a996940ebe12 Mon Sep 17 00:00:00 2001
From: Srisivasubramanian Srinivasan <Srisivasubramanian.Srinivasan@amd.com>
Date: Thu, 29 Oct 2026 00:35:15 +0530
Subject: [PATCH] soc: pensando: penfw: secure services support in new ioctl argument format

Few additional changes:
- use local variables to save the passed in lengths, to prevent memory leak/corruption during free
- Pass the input and output lengths in x5 and x6 registers of the SMC call to support EL3 services that need to know buffer sizes.
- Remove unsafe is_user_address_valid() function (High). Function used find_vma() incorrectly (only checks first byte). It was missing proper RCU/task lifetime handling. Kernel's copy_from_user/copy_to_user already validate addresses
- Add mutex serialization to PENFW_SVC path (High)
- Remove pid parameter from penfw_svc_smc() (cleanup)
- Make penfw_dev globally accessible (cleanup)
- Fix GFP allocation flags. Removed GFP_ATOMIC from GFP_KERNEL | GFP_ATOMIC
- Fix UAPI struct penfw_svc_args. Changed uint64_t/uint16_t to __u64/__u16 (kernel UAPI types) Added explicit padding: reserved1 (2 bytes), reserved2 (6 bytes) to prevent compiler-dependent ABI padding issues
-  pensando: penfw - add packed attribute and ioctl size validation
- Add static_assert checks to verify the struct layout: Total size must be 48 bytes, value field at offset 24 (verifies 6-byte padding after length_in) and status field at offset 40 (verifies 6-byte padding after length_out). These compile-time checks ensure the explicit padding in penfw_svc_args produces the expected layout, catching any compiler that might add different padding or misalign fields.

---------

Signed-off-by: Srisivasubramanian Srinivasan <Srisivasubramanian.Srinivasan@amd.com>
Signed-off-by: rahshekh <rahulshekhar@pensando.io>
---
 drivers/soc/pensando/penfw.h       | 27 ++++++++++
 drivers/soc/pensando/penfw_drv.c   | 85 +++++++++++++++++++++---------
 drivers/soc/pensando/penfw_smc.c   | 71 +++++++++++++++++++++++++
 drivers/soc/pensando/penfw_sysfs.c |  2 -
 4 files changed, 159 insertions(+), 26 deletions(-)

diff --git a/drivers/soc/pensando/penfw.h b/drivers/soc/pensando/penfw.h
index 951f238b6007..88f4a4c9d40a 100644
--- a/drivers/soc/pensando/penfw.h
+++ b/drivers/soc/pensando/penfw.h
@@ -66,11 +66,38 @@ struct penfw_secure_intrs {
 	struct penfw_intrreg *intr_regs;
 };
 
+/*
+ * penfw_svc_args - UAPI structure for PENFW_SVC ioctl
+ *
+ * This struct uses explicit padding (reserved1/reserved2) to ensure
+ * all fields are naturally aligned. The __attribute__((packed)) prevents
+ * any compiler from adding additional implicit padding, guaranteeing
+ * the layout is consistent across all toolchains and architectures.
+ */
+struct penfw_svc_args {
+	__u64 func_id;
+	__u64 sub_func_id;
+	__u16 length_in;
+	__u16 reserved1[3];	// explicit padding for natural alignment
+	__u64 value;		// pointer to input/output data
+	__u16 length_out;
+	__u16 reserved2[3];	// explicit padding for natural alignment
+	__s64 status;		// status of the smc operation
+} __attribute__((packed));
+
+/* Build-time layout verification */
+static_assert(sizeof(struct penfw_svc_args) == 48);
+static_assert(offsetof(struct penfw_svc_args, value) == 24);
+static_assert(offsetof(struct penfw_svc_args, status) == 40);
+
 #define PENFW_IOCTL_NUM  0xcd
 #define PENFW_FWCALL     _IOWR(PENFW_IOCTL_NUM, 1, struct penfw_call_args)
+#define PENFW_SVC        _IOWR(PENFW_IOCTL_NUM, 2, struct penfw_svc_args)
 
 void penfw_smc(struct penfw_call_args *args);
+long penfw_svc_smc(struct penfw_svc_args *args);
 
+extern struct device *penfw_dev;
 extern void *penfwdata;
 extern phys_addr_t penfwdata_phys;
 
diff --git a/drivers/soc/pensando/penfw_drv.c b/drivers/soc/pensando/penfw_drv.c
index c8a6f3320d4a..83b296398576 100644
--- a/drivers/soc/pensando/penfw_drv.c
+++ b/drivers/soc/pensando/penfw_drv.c
@@ -23,7 +23,7 @@
 
 static int    majorNumber;
 static struct class *penfw_class;
-static struct device *penfw_dev;
+struct device *penfw_dev;
 static DEFINE_MUTEX(penfw_mutex);
 
 void *penfwdata;
@@ -39,33 +39,71 @@ static long penfw_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 	long ret = 0;
 	void __user *argp = (void __user *)arg;
 	struct penfw_call_args penfw_args_ob;
-
-	mutex_lock(&penfw_mutex);
-
-	if (copy_from_user(&penfw_args_ob, argp, sizeof(penfw_args_ob))) {
-		dev_err(penfw_dev, "copy from user failed\n");
-		ret = -EFAULT;
-		goto err;
-	}
-
-	if (cmd != PENFW_FWCALL) {
+	struct penfw_svc_args penfw_svc_args;
+	size_t ioctl_size;
+
+	ioctl_size = _IOC_SIZE(cmd);
+
+	switch (cmd) {
+	case PENFW_FWCALL:
+		if (ioctl_size != sizeof(struct penfw_call_args)) {
+			dev_err(penfw_dev, "PENFW_FWCALL size mismatch: expected %zu, got %zu\n",
+				sizeof(struct penfw_call_args), ioctl_size);
+			ret = -EINVAL;
+			goto err;
+		}
+		if (copy_from_user(&penfw_args_ob, argp,
+					sizeof(penfw_args_ob))) {
+			dev_err(penfw_dev, "copy from user failed\n");
+			ret = -EFAULT;
+			goto err;
+		}
+		mutex_lock(&penfw_mutex);
+		penfw_smc(&penfw_args_ob);
+		mutex_unlock(&penfw_mutex);
+		// copy back data to user space struct
+		if (copy_to_user(argp, &penfw_args_ob, sizeof(penfw_args_ob))) {
+			dev_err(penfw_dev, "copy to user failed\n");
+			ret = -EFAULT;
+			goto err;
+		}
+		break;
+	case PENFW_SVC:
+		if (ioctl_size != sizeof(struct penfw_svc_args)) {
+			dev_err(penfw_dev, "PENFW_SVC size mismatch: expected %zu, got %zu\n",
+				sizeof(struct penfw_svc_args), ioctl_size);
+			ret = -EINVAL;
+			goto err;
+		}
+		if (copy_from_user(&penfw_svc_args, argp,
+					sizeof(penfw_svc_args))) {
+			dev_err(penfw_dev, "copy from user failed\n");
+			ret = -EFAULT;
+			goto err;
+		}
+		mutex_lock(&penfw_mutex);
+		ret = penfw_svc_smc(&penfw_svc_args);
+		mutex_unlock(&penfw_mutex);
+		if (ret != 0) {
+			dev_err(penfw_dev, "error in smc handling %ld\n",
+				ret);
+			goto err;
+		}
+		// copy back data to user space struct
+		if (copy_to_user(argp, &penfw_svc_args,
+					sizeof(penfw_svc_args))) {
+			dev_err(penfw_dev, "copy to user failed\n");
+			ret = -EFAULT;
+			goto err;
+		}
+		break;
+	default:
 		dev_err(penfw_dev, "received unsupported ioctl %u\n", cmd);
 		ret = -EOPNOTSUPP;
 		goto err;
 	}
 
-	penfw_smc(&penfw_args_ob);
-
-	// copy back data to user space struct
-	if (copy_to_user(argp, &penfw_args_ob, sizeof(penfw_args_ob))) {
-		dev_err(penfw_dev, "copy to user failed\n");
-		ret = -EFAULT;
-		goto err;
-	}
-
 err:
-	mutex_unlock(&penfw_mutex);
-
 	return ret;
 }
 
@@ -116,8 +154,7 @@ static int penfw_probe(struct platform_device *pdev)
 	dev_info(penfw_dev, "penfw sys initialization success\n");
 
 	// Allocate memory for smc calls
-	penfwdata = (struct penfw_data *)devm_get_free_pages(penfw_dev,
-									GFP_KERNEL | GFP_ATOMIC, 0);
+	penfwdata = (void *)devm_get_free_pages(penfw_dev, GFP_KERNEL, 0);
 	if (penfwdata == NULL) {
 		dev_err(penfw_dev, "penfw memory allocation failed\n");
 		return -1;
diff --git a/drivers/soc/pensando/penfw_smc.c b/drivers/soc/pensando/penfw_smc.c
index bc36b1c6dcbf..e668d9524bc7 100644
--- a/drivers/soc/pensando/penfw_smc.c
+++ b/drivers/soc/pensando/penfw_smc.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2021, Pensando Systems Inc.
  */
 
+#include <linux/device.h>
 #include <linux/string.h>
 #include <linux/arm-smccc.h>
 #include <linux/printk.h>
@@ -263,3 +264,73 @@ void penfw_smc(struct penfw_call_args *args)
 	pr_debug("penfw: smc return a0: 0x%llx a1: 0x%llx a2: 0x%llx a3: 0x%llx\n",
 		 args->a0, args->a1, args->a2, args->a3);
 }
+
+long penfw_svc_smc(struct penfw_svc_args *args)
+{
+	struct arm_smccc_res res = { 0 };
+	void *cfg = NULL;
+	void *cfg_out = NULL;
+	phys_addr_t cfg_phys = 0;
+	phys_addr_t cfg_phys_out = 0;
+	long ret = 0;
+	size_t length_in = args->length_in;
+	size_t length_out = args->length_out;
+
+	if (length_in != 0) {
+		cfg = (void *)__get_free_pages(GFP_KERNEL | __GFP_ZERO,
+						get_order(length_in));
+		if (cfg == NULL) {
+			dev_err(penfw_dev, "penfw svc memory allocation failed\n");
+			ret = -ENOMEM;
+			goto err;
+		}
+		cfg_phys = virt_to_phys(cfg);
+		if (copy_from_user(cfg, (void __user *)args->value,
+					length_in)) {
+			dev_err(penfw_dev, "Unable to copy argument %llx from user for smc cmd(%llx/%llx)\n",
+				args->value, args->func_id, args->sub_func_id);
+			ret = -EFAULT;
+			goto err;
+		}
+	}
+	if (length_out != 0) {
+		cfg_out = (void *)__get_free_pages(GFP_KERNEL | __GFP_ZERO,
+						get_order(length_out));
+		if (cfg_out == NULL) {
+			dev_err(penfw_dev,
+				"penfw svc out memory allocation failed\n");
+			ret = -ENOMEM;
+			goto err;
+		}
+		cfg_phys_out = virt_to_phys(cfg_out);
+	}
+	arm_smccc_smc(args->func_id, args->sub_func_id, cfg_phys,
+			cfg_phys_out, length_in, length_out, 0, 0, &res);
+	// copy back to user only if SMC operation is successful
+	if ((res.a0 == 0) && args->length_out) {
+		if (res.a1 <= args->length_out) {
+			if (copy_to_user((void __user *)args->value, cfg_out,
+						res.a1)) {
+				dev_err(penfw_dev, "copy to user failed\n");
+				ret = -EFAULT;
+				goto err;
+			}
+		} else {
+			dev_err(penfw_dev,
+				"penfw svc out memory allocation not enough\n");
+			ret = -EINVAL;
+			goto err;
+		}
+		args->length_out = res.a1;
+	}
+	args->status = res.a0;
+
+err:
+	if (cfg_out)
+		free_pages((unsigned long)cfg_out, get_order(length_out));
+	if (cfg)
+		free_pages((unsigned long)cfg, get_order(length_in));
+
+	return ret;
+}
+
diff --git a/drivers/soc/pensando/penfw_sysfs.c b/drivers/soc/pensando/penfw_sysfs.c
index 3913b2c957bf..2ff1e549d165 100644
--- a/drivers/soc/pensando/penfw_sysfs.c
+++ b/drivers/soc/pensando/penfw_sysfs.c
@@ -8,8 +8,6 @@
 #include <linux/fs.h>
 #include <linux/types.h>
 #include <linux/device.h>
-#include <linux/device.h>
-#include <linux/types.h>
 #include <linux/string.h>
 #include <linux/module.h>
 
