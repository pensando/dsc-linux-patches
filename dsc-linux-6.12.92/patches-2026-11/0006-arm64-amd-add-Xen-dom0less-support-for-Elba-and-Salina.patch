+// SPDX-License-Identifier: GPL-2.0
+
+/dts-v1/;
+
+/ {
+	model = "Elba ASIC Board";
+	compatible = "pensando,elba";
+
+	aliases {
+		serial0 = &uart0;
+		spi0 = &spi0;
+		spi1 = &qspi;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "earlycon=uart8250,mmio32,0x4800 softdog.soft_panic=1 root=PARTUUID=D4E53BE5-7DC1-4199-914C-48EDFEA92C5E rootwait FW_NAME=mainfwa console=ttyS0,115200n8";
+		xen,xen-bootargs = "console=dtuart dtuart=serial0 loglvl=all guest_loglvl=all bootscrub=0 sched=null dom0_mem=4G dom0_max_vcpus=4";
+
+		smartnic_cpupool {
+			compatible = "xen,cpupool";
+			cpupool-cpus = <0x0000000d 0x0000000e 0x0000000f 0x00000010
+				       0x00000011 0x00000012 0x00000013 0x00000014
+				       0x00000015 0x00000016 0x00000017 0x00000018>;
+			cpupool-sched = "null";
+			phandle = <0xfde7>;
+		};
+
+		hostnic_cpupool {
+			compatible = "xen,cpupool";
+			cpupool-cpus = <0x0000001b 0x0000001c>;
+			cpupool-sched = "null";
+			phandle = <0xfde6>;
+		};
+
+		domU0 {
+			compatible = "xen,domain";
+			#address-cells = <2>;
+			#size-cells = <2>;
+
+			memory = <0x00 0x00f68000>;  // 15776 MB
+			cpus = <12>;		// Replace as needed
+			vpl011;
+			direct-map;
+			domain-cpupool = <0xfde7>;
+
+			xen,static-mem = <
+				/* paddr0, size0: not set */
+				0x00 0x98000000 0x00 0x20000000       // static_mem1: 512M
+				0x12 0x80000000 0x03 0x80000000       // static_mem2: 14336M
+				/* paddr3, size3: not set */
+				0x17 0x80000000 0x00 0x3a000000       // static_mem4: 928M
+				/* paddr5, size5: not set */>;
+
+			module1 {
+				bootargs = "root=PARTUUID=D4E53BE5-7DC1-4199-914C-48EDFEA92C5E rootwait FW_NAME=mainfwa earlycon=pl011,mmio32,0x5000 console=ttyAMA0 softdog.soft_noboot=1 ignore_loglevel";
+				reg = <0x00000000 0x87000000 0x00000000 0x0110e808>;
+				compatible = "multiboot,kernel", "multiboot,module";
+			};
+
+			module2 {
+				reg = <0x00000000 0x85000000 0x00000000 0x00010000>;
+				compatible = "multiboot,device-tree", "multiboot,module";
+			};
+
+		};
+		domU1 {
+			compatible = "xen,domain";
+			#address-cells = <2>;
+			#size-cells = <2>;
+
+			memory = <0x0 0x00500000>;
+			cpus = <2>;
+			vpl011;
+			direct-map;
+			domain-cpupool = <0xfde6>;
+
+			xen,static-mem = <0x00000016 0x00000000 0x00000001 0x40000000>;
+			module1 {
+				bootargs = "root=/dev/ram rw init=/init earlycon=pl011,mmio32,0x5000 console=ttyAMA0 softdog.soft_noboot=1 FW_NAME=goldfw ignore_loglevel";
+				reg = <0x00000000 0x90000000 0x00000000 0x0110e808>;
+				compatible = "multiboot,kernel", "multiboot,module";
+			};
+
+			module2 {
+				reg = <0x00000000 0x86000000 0x00000000 0x00010000>;
+				compatible = "multiboot,device-tree", "multiboot,module";
+			};
+
+			ramdisk {
+				reg = <0x00000017 0x40000000 0x00000000 0x0d889000>;
+				compatible = "multiboot,ramdisk", "multiboot,module";
+			};
+		};
+	};
+};
+
