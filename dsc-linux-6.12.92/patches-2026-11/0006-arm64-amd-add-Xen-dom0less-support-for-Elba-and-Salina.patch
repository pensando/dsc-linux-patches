+/include/ "salina-n1-flash-parts.dtsi"
+
+/*
+ * Dataplane note (Salina): pcie / kpcimgr / pciemac / uio_penmsi1 are owned by
+ * the A35 core (Zephyr) on Salina, NOT N1 Linux, so they are deliberately not
+ * passed through to this domU (unlike the Elba smartnic). capmem + captun above
+ * cover the Linux-side device memory and smartnic<->hostnic tunnel.
+ *
+ * Still to confirm whether these belong to N1 Linux on Salina (omitted for now):
+ *   sbus@...      (Elba sbus@307c24a8/b8/c8, sbus@6f242134)
+ *   panicdump@... (Elba panicdump@740b0000)
+ * Plus any U-Boot fixup blocks (ft_system_setup / edac_fdt_setup /
+ * emmc_bypass_setup) once confirmed.
+ */
diff --git a/arch/arm64/boot/dts/amd/salina-asic-xen.dts b/arch/arm64/boot/dts/amd/salina-asic-xen.dts
new file mode 100644
index 000000000000..dd1c8f34d0e1
--- /dev/null
+++ b/arch/arm64/boot/dts/amd/salina-asic-xen.dts
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: (GPL-2.0-only or BSD-2-Clause)
+/*
+ * Device Tree file for AMD Pensando Salina Board - Xen dom0less host.
+ *
+ * Copyright 2023-2024 Advanced Micro Devices, Inc.
+ *
+ * This is the Xen hypervisor host device tree (equivalent of
+ * elba-asic-xen.dts). It carries the dom0less /chosen/domU0 + /chosen/domU1
+ * domain descriptions and cpupools. U-Boot patches the real /memory node and
+ * the SoC fixups in at boot (ft_system_setup), so only the Xen/domU layout and
+ * SoC nodes live here.
+ *
+ * Memory layout below is derived from the Leni_64GB U-Boot DDR map:
+ *   LINUX NS CC regions available to Xen/guests:
+ *     0x00_80000000..0x00_804fffff   5 MiB
+ *     0x00_80f00000..0x00_bfffffff   ~1009 MiB   (Xen + domU staging load area)
+ *     0x00_c4000000..0x00_dfffffff   448 MiB
+ *     0x82_00800000..0x82_bfffffff   ~2.99 GiB
+ *     0x87_1c000000..0x87_dfffffff   ~3.06 GiB
+ *     0x88_00000000..0x8f_f9ffffff   ~32 GiB     (top 96 MiB = mnet dma pool)
+ */
+
+/dts-v1/;
+
+/ {
+	model = "Salina ASIC Board";
+	compatible = "pensando,salina";
+
+	aliases {
+		serial1 = &uart1;
+		spi0 = &spi0;
+		spi1 = &spi1;
+		i2c0 = &i2c1;	/* i2c@20000 -> Linux i2c-0 */
+		i2c1 = &i2c2;	/* i2c@30000 -> Linux i2c-1 (Sensors) */
+		i2c2 = &i2c3;	/* i2c@40000 -> Linux i2c-2 (MCTP) */
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+		bootargs = "earlycon=ns16550a,mmio32,0x100000 softdog.soft_panic=1 root=PARTUUID=D4E53BE5-7DC1-4199-914C-48EDFEA92C5E rootwait FW_NAME=mainfwa console=ttyS1,115200n8";
+		/*
+		 * sync_console is REQUIRED on Salina: the dtuart (serial@100000, GIC_SPI 5)
+		 * interrupt is not reliably delivered to Xen, and in this dom0less config
+		 * the console poll-timer runs on idle boot-CPU0 (Pool-0 has no dom0) and
+		 * stops draining once d1 runs. sync_console drains TX on the writing CPU,
+		 * sidestepping both. See memory: xen-salina-domu-console-hang.
+		 */
+		xen,xen-bootargs = "console=dtuart dtuart=serial1 sync_console loglvl=all guest_loglvl=all bootscrub=0 sched=null dom0_mem=4G dom0_max_vcpus=4";
+
+		/*
+		 * Salina has 16 A35 cores (0..15). dom0 takes the default pool
+		 * (cores 0-3, dom0_max_vcpus=4). smartnic gets 10 cores, hostnic
+		 * gets 2. Adjust core split per product requirements.
+		 */
+		smartnic_cpupool {
+			compatible = "xen,cpupool";
+			/* cores 4-13 (10). Use &cpuN label refs: cpupool-cpus
+			 * holds CPU-node phandles, not CPU indices.
+			 */
+			cpupool-cpus = <&cpu4 &cpu5 &cpu6 &cpu7 &cpu8
+					&cpu9 &cpu10 &cpu11 &cpu12 &cpu13>;
+			cpupool-sched = "null";
+			phandle = <0xfde7>;
+		};
+
+		hostnic_cpupool {
+			compatible = "xen,cpupool";
+			/* cores 14-15 (2) */
+			cpupool-cpus = <&cpu14 &cpu15>;
+			cpupool-sched = "null";
+			phandle = <0xfde6>;
+		};
+
+		domU0 {
+			compatible = "xen,domain";
+			#address-cells = <2>;
+			#size-cells = <2>;
+
+			/* 16 GiB. NB: "memory" is a scalar u64 in KiB (NOT the
+			 * addr/size-cell byte form used by xen,static-mem):
+			 * 16 GiB = 16777216 KiB = 0x0100_0000.
+			 */
+			memory = <0x00 0x01000000>;	/* 16 GiB in KiB */
+			cpus = <10>;	/* smartnic: cores 4-13 (smartnic_cpupool) */
+			vpl011;
+			direct-map;
+			domain-cpupool = <0xfde7>;
+
+			/* smartnic guest RAM: 16 GiB from the 32 GiB bank @ 0x88_00000000 */
+			xen,static-mem = <0x88 0x00000000 0x04 0x00000000>;
+
+			/* vsmc: required — Oracle Leni reference smartnic domain has it.
+			 * Without it the guest's post-PSCI SMCCC probing is not
+			 * virtualized and wedges the hypervisor (Xen console dead).
+			 *
+			 * Declared as a NODE with `strict;` (not a bare `vsmc;`
+			 * property): strict makes Xen's make_secure_mode_node() honor
+			 * the HOST /secure_mode/enable (U-Boot sets it from env
+			 * `secure_mode`) instead of hard-defaulting enable=1 for
+			 * non-strict domains (OCI Xen 4.22 commit 545958ab7c6c
+			 * "make vSMC secure mode strict opt-in"; node added by
+			 * 3f158e5e5f71). An empty node has no `id` child entries so
+			 * vsmc_policy.count==0
+			 * and the default SMC allow-switch is unchanged (penfw/crypto/
+			 * dice/secreg/barco still forward).
+			 */
+			vsmc {
+				strict;
+			};
+
+			module1 {
+				bootargs = "root=PARTUUID=D4E53BE5-7DC1-4199-914C-48EDFEA92C5E rootwait FW_NAME=mainfwa earlycon=pl011,mmio32,0x5000 console=ttyAMA0 softdog.soft_noboot=1 ignore_loglevel";
+				reg = <0x00000000 0x87000000 0x00000000 0x02000000>;
+				compatible = "multiboot,kernel", "multiboot,module";
+			};
+
+			module2 {
+				reg = <0x00000000 0x85000000 0x00000000 0x00010000>;
+				compatible = "multiboot,device-tree", "multiboot,module";
+			};
+		};
+
+		domU1 {
+			compatible = "xen,domain";
+			#address-cells = <2>;
+			#size-cells = <2>;
+
+			memory = <0x00 0x00200000>;	/* 2 GiB */
+			cpus = <2>;
+			vpl011;
+			direct-map;
+			domain-cpupool = <0xfde6>;
+
+			/* hostnic guest RAM: 2 GiB from the ~3 GiB bank @ 0x82_00800000 */
+			xen,static-mem = <0x82 0x00800000 0x00 0x80000000>;
+
+			module1 {
+				bootargs = "root=/dev/ram rw init=/init earlycon=pl011,mmio32,0x5000 console=ttyAMA0 softdog.soft_noboot=1 FW_NAME=goldfw ignore_loglevel";
+				reg = <0x00000000 0x90000000 0x00000000 0x02000000>;
+				compatible = "multiboot,kernel", "multiboot,module";
+			};
+
+			module2 {
+				reg = <0x00000000 0x86000000 0x00000000 0x00010000>;
+				compatible = "multiboot,device-tree", "multiboot,module";
+			};
+
+			ramdisk {
+				/*
+				 * Staging area in the first 4 GiB of DRAM U-Boot
+				 * can map.  Xen copies the initrd to domU1's
+				 * static-mem after boot.
+				 */
+				reg = <0x00000000 0x95000000 0x00000000 0x00800000>;
+				compatible = "multiboot,ramdisk", "multiboot,module";
+			};
+		};
+	};
+
+	tawkipc {
+		compatible = "amd,tawk-ipc";
+		peer-id = <1>;
+		#address-cells = <2>;
+		#size-cells = <1>;
+		reg = <0x0 0x0 0x0 0x0>,  /* doorbells */
+			<0x0 0x0 0x0 0x0>, /* msix-like table */
+			<0x47 0xe1d2b100 0x0 0x8>,  /* reset signal registers */
+			<0x47 0xe1d2c100 0x0 0x10>,	/* mailbox control registers */
+			<0x47 0xe1d2d100 0x0 0x800>;	/* mailbox buffers */
+		rst-sigs = <0x4 0x0>;
+		nmboxes = <2>;
+		mbox-ctl = <0x0 0x3>;
+		mbox-buf = <0x0 0xa 0x400>;
+		status = "okay";
+	};
+};
+
+#include "salina-asic.dtsi"
+#include "salina-16core.dtsi"
+#include "salina-16core-psci.dtsi"
+#include "salina-n1-common.dtsi"
+#include "salina-n1-flash-parts.dtsi"
+#include "elba-asic-memory.dtsi"
+#include "elba-mdev.dtsi"
+#include "salina-asic-common.dtsi"
+
+/*
+ * Route the CPLD->SoC interrupt (GPIO porta line, GIC SPI 2) to the smartnic
+ * domU. Xen dom0less passthrough routes IRQs via map_device_irqs_to_domain()
+ * on the node named by the guest's xen,path = "/soc/gpio@d0000", and reads
+ * only THAT node's "interrupts". The real SPI-2 IRQ is declared on the
+ * gpio-controller@0 child (porta), so the parent carries none and Xen routes
+ * nothing. Without this the rd1173 i2c completion IRQ (porta -> SPI 2) never
+ * reaches d1: every xfer hits "RD1173: timeout waiting for completion",
+ * resets, and retries forever, stalling mnic bring-up before login.
+ */
+&gpio0 {
+	interrupts = <0 2 4>;
+	interrupt-parent = <&gic>;
+};
