diff --git a/Documentation/devicetree/bindings/xen/multiboot,module.yaml b/Documentation/devicetree/bindings/xen/multiboot,module.yaml
new file mode 100644
index 000000000000..4c92d0f35d94
--- /dev/null
+++ b/Documentation/devicetree/bindings/xen/multiboot,module.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/xen/multiboot,module.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xen multiboot boot module
+
+maintainers:
+  - Brad Larson <blarson@amd.com>
+
+description: |
+  A boot module (kernel, ramdisk or partial device tree) already loaded in
+  memory by the bootloader, described to the Xen hypervisor. Modules appear
+  under /chosen for dom0 or under a xen,domain node for dom0less guests.
+
+  The authoritative description is docs/misc/arm/device-tree/booting.txt in
+  the Xen source tree.
+
+properties:
+  compatible:
+    oneOf:
+      - items:
+          - enum:
+              - multiboot,kernel
+              - multiboot,ramdisk
+              - multiboot,device-tree
+          - const: multiboot,module
+      - const: multiboot,module
+
+  reg:
+    maxItems: 1
+    description: Physical address and size of the module in RAM.
+
+  bootargs:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: Command line for a kernel module.
+
+  xen,uefi-binary:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: File name loaded by the Xen UEFI stub (UEFI boot only).
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    domU0 {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        module@87000000 {
+            compatible = "multiboot,kernel", "multiboot,module";
+            reg = <0x0 0x87000000 0x0 0x02000000>;
+            bootargs = "console=ttyAMA0";
+        };
+
+        module@85000000 {
+            compatible = "multiboot,device-tree", "multiboot,module";
+            reg = <0x0 0x85000000 0x0 0x00010000>;
+        };
+    };
+
+...
diff --git a/Documentation/devicetree/bindings/xen/xen,cpupool.yaml b/Documentation/devicetree/bindings/xen/xen,cpupool.yaml
new file mode 100644
index 000000000000..301dcaffcb33
--- /dev/null
+++ b/Documentation/devicetree/bindings/xen/xen,cpupool.yaml
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/xen/xen,cpupool.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xen boot-time cpupool
+
+maintainers:
+  - Brad Larson <blarson@amd.com>
+
+description: |
+  A node under /chosen of the device tree passed to the Xen hypervisor that
+  creates a cpupool at boot. Domains are placed in a pool with the
+  domain-cpupool property of a xen,domain node.
+
+  The authoritative description is docs/misc/arm/device-tree/cpupools.txt in
+  the Xen source tree.
+
+properties:
+  compatible:
+    const: xen,cpupool
+
+  cpupool-cpus:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 1
+    items:
+      maxItems: 1
+    description: Phandles of the CPU nodes assigned to the pool.
+
+  cpupool-sched:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [credit, credit2, rtds, arinc653, "null"]
+    description: Scheduler for the pool. Defaults to the Xen default scheduler.
+
+required:
+  - compatible
+  - cpupool-cpus
+
+additionalProperties: false
+
+examples:
+  - |
+    cpus {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        cpu2: cpu@200 {
+            compatible = "arm,neoverse-n1";
+            device_type = "cpu";
+            reg = <0x200>;
+            enable-method = "psci";
+        };
+
+        cpu3: cpu@300 {
+            compatible = "arm,neoverse-n1";
+            device_type = "cpu";
+            reg = <0x300>;
+            enable-method = "psci";
+        };
+    };
+
+    cpupool {
+        compatible = "xen,cpupool";
+        cpupool-cpus = <&cpu2 &cpu3>;
+        cpupool-sched = "null";
+    };
+
+...
diff --git a/Documentation/devicetree/bindings/xen/xen,domain.yaml b/Documentation/devicetree/bindings/xen/xen,domain.yaml
new file mode 100644
index 000000000000..bba487d026d4
--- /dev/null
+++ b/Documentation/devicetree/bindings/xen/xen,domain.yaml
@@ -0,0 +1,137 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/xen/xen,domain.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xen dom0less domain
+
+maintainers:
+  - Brad Larson <blarson@amd.com>
+
+description: |
+  A node under /chosen of the device tree passed to the Xen hypervisor that
+  describes a guest domain for Xen to create at boot (dom0less). The node is
+  consumed by Xen and is not passed to any guest. Child nodes describe the
+  boot modules (kernel, ramdisk, partial device tree) loaded for the domain.
+
+  The authoritative description is docs/misc/arm/device-tree/booting.txt in
+  the Xen source tree.
+
+properties:
+  compatible:
+    const: xen,domain
+
+  "#address-cells":
+    const: 2
+
+  "#size-cells":
+    const: 2
+
+  memory:
+    $ref: /schemas/types.yaml#/definitions/uint64
+    description: Amount of guest RAM in KiB.
+
+  cpus:
+    description:
+      Number of vCPUs (a single cell, unlike the phandle-array cpus property
+      of other bindings).
+
+  capabilities:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Bit field of domain capabilities for a disaggregated system.
+
+  vpl011:
+    type: boolean
+    description: Provide a virtual PL011 UART to the guest.
+
+  nr_spis:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Number of SPIs to allocate for the domain.
+
+  direct-map:
+    type: boolean
+    description:
+      Map guest memory 1:1 (guest physical == host physical). Requires
+      xen,static-mem.
+
+  domain-cpupool:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The xen,cpupool node the domain is started in.
+
+  xen,static-mem:
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    description:
+      Statically allocated guest memory as address/size pairs, sized by the
+      address and size cell counts of this node.
+
+  xen,enhanced:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [enabled, legacy, disabled, no-xenstore]
+    description: Xen PV interfaces (grant table, xenstore) exposed to the guest.
+
+  passthrough:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [enabled, disabled]
+    description: Whether IOMMU mappings are enabled for device passthrough.
+
+  vfru:
+    type: boolean
+    description: Provide the virtual FRU interface to the guest.
+
+  vsmc:
+    type: object
+    description:
+      Virtual SMC (secure monitor call) forwarding for the guest. Child
+      nodes, if present, list the SMC function IDs the guest may issue.
+
+    properties:
+      strict:
+        type: boolean
+        description: Only forward SMCs that match a listed function ID.
+
+    additionalProperties:
+      type: object
+      description: Allowed SMC function ID, with optional sub-function nodes.
+
+patternProperties:
+  "^(module|kernel|ramdisk|device-tree)[0-9]*(@[0-9a-f]+)?$":
+    type: object
+    description: Boot module, see multiboot,module.yaml.
+
+required:
+  - compatible
+  - "#address-cells"
+  - "#size-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    domU1 {
+        compatible = "xen,domain";
+        #address-cells = <2>;
+        #size-cells = <2>;
+        memory = <0x0 0x200000>;
+        cpus = <2>;
+        vpl011;
+        direct-map;
+        xen,static-mem = <0x82 0x00800000 0x0 0x80000000>;
+
+        vsmc {
+            strict;
+        };
+
+        module@90000000 {
+            compatible = "multiboot,kernel", "multiboot,module";
+            reg = <0x0 0x90000000 0x0 0x02000000>;
+            bootargs = "console=ttyAMA0";
+        };
+
+        ramdisk@871c000000 {
+            compatible = "multiboot,ramdisk", "multiboot,module";
+            reg = <0x87 0x1c000000 0x0 0x10000000>;
+        };
+    };
+
+...
