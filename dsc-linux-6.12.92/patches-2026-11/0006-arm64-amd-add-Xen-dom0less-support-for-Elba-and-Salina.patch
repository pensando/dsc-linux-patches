diff --git a/arch/arm64/boot/dts/amd/salina-asic-hostnic.dts b/arch/arm64/boot/dts/amd/salina-asic-hostnic.dts
new file mode 100644
index 000000000000..64985a9719f6
--- /dev/null
+++ b/arch/arm64/boot/dts/amd/salina-asic-hostnic.dts
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (c) 2023-2024, Advanced Micro Devices, Inc. */
+
+/dts-v1/;
+/* HostNIC - Salina Xen domU (partial device tree) */
+
+/*
+ * Ported from elba-asic-hostnic.dts. The Elba hostnic is almost entirely a
+ * dataplane passthrough (pcie, kpcimgr, pciemac, uio_penmsi1, capmem, captun),
+ * whose Salina physical addresses differ from Elba and are NOT present in the
+ * Salina tree. This minimal version brings up a bootable domU (clocks + one
+ * mnet + mnet dma pool); the NIC dataplane nodes are listed in the
+ * "DATAPLANE TODO" block and must be filled with Salina addresses.
+ */
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	gic: gic {
+		/* Dummy gic node, only used for phandle reference.
+		 * Xen will populate real vGIC node.
+		 */
+		#interrupt-cells = <3>;
+		interrupt-controller;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		mnet_reserved: mnet_dma_region {
+			compatible = "shared-dma-pool";
+			no-map;
+			size = <0x0 0x6000000>;
+			alignment = <0x0 0x1000>;
+		};
+	};
+
+	passthrough {
+		compatible = "simple-bus";
+		ranges;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		dma-coherent;
+
+		ahb_clk: oscillator0 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		emmc_clk: oscillator2 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <200000000>;
+		};
+
+		flash_clk: oscillator3 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		ref_clk: oscillator4 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <100000000>;
+		};
+
+		gmac_clk: oscillator5 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <200000000>;
+		};
+
+		mnet0: mnet0 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x0>;
+			memory-region = <&mnet_reserved>;
+		};
+
+		/* Salina capmem fixed-ranges (from salina-asic.dtsi); attr 0x4 = DEVICE.
+		 * The GIC block 0x1000000-0x1260000 (GICD 0x1000000 + ITS 0x1040000 +
+		 * GICR 0x1060000) is carved OUT — same fix as the smartnic. Direct-
+		 * device-mapping the GIC bypasses Xen's vGIC/vITS; the guest hits the
+		 * physical redistributors/ITS ("Booted with LPIs enabled, memory
+		 * probably corrupted" / "Failed to disable LPIs") and hangs bringing
+		 * up secondary vCPUs. Xen emulates GICD+GICR+ITS, so these must trap.
+		 */
+		capmem {
+			compatible = "pensando,capmem";
+			pensando,capmem-fixed-ranges =
+				<0x0 0x10000 0x0 0xff0000 0x4>,      /* below GIC */
+				<0x0 0x1260000 0x0 0x6eda0000 0x4>,  /* above GICR */
+				<0x2 0x40000000 0x0 0x8000000 0x4>;
+			/* Coherent + non-coherent DP/shared RAM windows; captun shared_mem
+			 * 0xc5ff7000 lives in the 0xc4000000 non-coherent range. Mirrors the
+			 * smartnic + Elba — maps the shared window so captun's mmap works.
+			 */
+			pensando,capmem-ranges =
+				<0x0 0xc0000000 0x0 0x04000000 0x1>,   /* coherent */
+				<0x0 0xc4000000 0x1 0x3c000000 0x0>,   /* non-coherent (captun) */
+				/*
+				 * hbm_mem_hostnic.json bypass and hi ranges (U-Boot DP memlayout
+				 * [8] above the snic's session_info, [10] at DDR offset 12-15G):
+				 * 0x1020000000-0x107fffffff bypass, 0x4300000000-0x43bfffffff NC
+				 */
+				<0x10 0x20000000 0x0 0x60000000 0x2>,  /* bypass */
+				<0x43 0x00000000 0x0 0xc0000000 0x0>;  /* non-coherent */
+		};
+
+		/* captun tunnel to smartnic (mirror of smartnic captun, reversed) */
+		captun {
+			compatible = "oracle,captun";
+			shared_mem = <0x0 0xc5ff7000>;
+			shared_size = <0x0 0x8000>;
+			endpoint_addr = "169.254.1.200";
+			local_addr = "169.254.1.100";
+		};
+	};
+};
+
+/*
+ * Dataplane note (Salina): the Elba hostnic was almost entirely PCIe dataplane
+ * (pcie / kpcimgr / pciemac / uio_penmsi1). On Salina those live on the A35
+ * (Zephyr), not N1 Linux, so this domU is just the captun endpoint + mnet.
+ */
diff --git a/arch/arm64/boot/dts/amd/salina-asic-smartnic.dts b/arch/arm64/boot/dts/amd/salina-asic-smartnic.dts
new file mode 100644
index 000000000000..1eef8451fad5
--- /dev/null
+++ b/arch/arm64/boot/dts/amd/salina-asic-smartnic.dts
@@ -0,0 +1,601 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (c) 2023-2024, Advanced Micro Devices, Inc. */
+
+/dts-v1/;
+/* SmartNIC - Salina Xen domU (partial device tree) */
+
+/*
+ * Ported from elba-asic-smartnic.dts. SoC control-plane passthrough addresses
+ * are Salina-specific (from salina-asic.dtsi):
+ *   syscon@61000000  spi@b0000  spi@a0000(qspi1)  gpio@d0000
+ *   sdio-host-chip@600000  i2c@30000  i2c@40000  watchdog@50000
+ *   edac@42c00000  ethernet@6d73a000  serial@100000
+ * Unlike Elba, Salina peripherals are each on their own 64K page, so the
+ * passthrough xen,reg entries do not need the "shared page" overlap handling.
+ *
+ * NOTE: the dataplane passthrough nodes (capmem physical ranges, sbus, pcie,
+ * kpcimgr, pciemac, captun, panicdump) are NOT included yet - their Salina
+ * physical addresses differ from Elba and are not present in the Salina tree.
+ * See the "DATAPLANE TODO" block at the end. Without them this domU boots
+ * under Xen with control-plane devices but no NIC dataplane.
+ */
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		i2c1 = &i2c2;	/* i2c@30000 -> /dev/i2c-1 (sensors/FRU); agent's fixed path */
+		i2c2 = &i2c3;	/* i2c@40000 -> Linux /dev/i2c-2 (MCTP) */
+		spi0 = &spi0;
+		spi1 = &qspi1;
+	};
+
+	gic: gic {
+		/* Dummy gic node, only used for phandle reference.
+		 * Xen will populate real vGIC node.
+		 */
+		#interrupt-cells = <3>;
+		interrupt-controller;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		mnet_reserved: mnet_dma_region {
+			compatible = "shared-dma-pool";
+			no-map;
+			size = <0x0 0x6000000>;
+			alignment = <0x0 0x1000>;
+		};
+	};
+
+	passthrough {
+		compatible = "simple-bus";
+		ranges;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		dma-coherent;
+
+		ahb_clk: oscillator0 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		emmc_clk: oscillator2 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <200000000>;
+		};
+
+		flash_clk: oscillator3 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		ref_clk: oscillator4 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <100000000>;
+		};
+
+		gmac_clk: oscillator5 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <200000000>;
+		};
+
+		/* MSI-capable dataplane devices (ITS phandle hardcoded as on Elba) */
+		mnet0: mnet0 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x0>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet1: mnet1 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x1>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet2: mnet2 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x2>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet3: mnet3 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x3>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet4: mnet4 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x4>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet5: mnet5 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x5>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet6: mnet6 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x6>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet7: mnet7 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x7>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet8: mnet8 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x8>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet9: mnet9 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x9>;
+			memory-region = <&mnet_reserved>;
+		};
+
+		mcrypt0: mcrypt0 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xb>;
+		};
+		mcrypt1: mcrypt1 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xc>;
+		};
+		mcrypt2: mcrypt2 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xd>;
+		};
+		mcrypt3: mcrypt3 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xe>;
+		};
+
+		/* Salina capmem (from salina-asic.dtsi). fixed-ranges attr 0x4 =
+		 * DSC_MEM_ATTR_DEVICE (dataplane register windows). capmem-ranges adds
+		 * the coherent/non-coherent shared-RAM windows — REQUIRED for captun
+		 * (shared_mem 0xc5ff7000 is in the 0xc4000000 non-coherent window);
+		 * without it the capmem driver exposes no RAM window and captun's mmap
+		 * fails. (The full DP/PCIe path still runs on the A35/Zephyr, not N1.)
+		 *
+		 * DEBUG (Xen domU hang): base raised 0x10000 -> 0x200000 (excludes the
+		 * console UART 0x100000 + low SoC peripherals, already xen,reg'd), AND
+		 * the GIC block 0x1000000-0x1260000 (GICD 0x1000000 + ITS 0x1040000 +
+		 * GICR 0x1060000) is carved OUT. Direct-device-mapping the GIC bypassed
+		 * Xen's vGIC/vITS (guest hit the physical redistributors/ITS: host LPI
+		 * state leaked, and secondary-vCPU redistributor init wedged). Xen
+		 * emulates GICD+GICR+ITS (CONFIG_HAS_ITS), so these must trap, not map.
+		 */
+		capmem {
+			compatible = "pensando,capmem";
+			pensando,capmem-fixed-ranges =
+				<0x0 0x200000  0x0 0xe00000   0x4>,   /* below GIC */
+				<0x0 0x1260000 0x0 0x6eda0000 0x4>,   /* above GICR */
+				<0x2 0x40000000 0x0 0x8000000 0x4>;
+			/* Coherent + non-coherent DP/shared RAM windows; captun shared_mem
+			 * 0xc5ff7000 lives in the 0xc4000000 non-coherent range. Salina was
+			 * missing capmem-ranges entirely ("capmem-ranges not found"), so
+			 * /bin/captun's mmap of the shared window failed. Mirrors Elba.
+			 */
+			pensando,capmem-ranges =
+				<0x0 0xc0000000 0x0 0x04000000 0x1>,   /* coherent */
+				<0x0 0xc4000000 0x1 0x3c000000 0x0>,   /* non-coherent (captun) */
+				/* 0x1000000000 .. 0x1080000000 LLC-bypass (attr 0x2 =
+				 * DSC_MEM_ATTR_BYPASS): HBM dataplane region [8] (U-Boot map
+				 * "DP NS NC BYP"). athena pipeline_init mmaps session_info @
+				 * 0x1000000000 (512 MiB) through /dev/capmem to program the
+				 * HBM table base addresses. Without this entry Xen never
+				 * p2m-maps the region AND the capmem driver's cap_mem_mmap
+				 * rejects it -> mmap returns MAP_FAILED -> mmap_region.c:68
+				 * assert (SIGABRT in asicpd_set_hbm_table_base_addr).
+				 * Mirrors elba-asic-smartnic.dts; Salina has no 0x1200000000
+				 * region so that second Elba bypass/NC entry is omitted.
+				 */
+				<0x10 0x00000000 0x0 0x80000000 0x2>;  /* bypass */
+		};
+
+		captun {
+			compatible = "oracle,captun";
+			shared_mem = <0x0 0xc5ff7000>;
+			shared_size = <0x0 0x8000>;
+			endpoint_addr = "169.254.1.100";
+			local_addr = "169.254.1.200";
+			initialize = "yes";
+		};
+
+		/* syscon (Elba: mssoc@307c0000 -> Salina: syscon@61000000) */
+		syscon: syscon@61000000 {
+			compatible = "amd,pensando-elba-syscon", "syscon";
+			reg = <0x0 0x61000000 0x0 0x80000>;
+			xen,reg = <0x0 0x61000000 0x0 0x80000 0x0 0x61000000>;
+			xen,path = "/soc/syscon@61000000";
+			xen,force-assign-without-iommu;
+		};
+
+		/*
+		 * spi0 drives the elbasr/CPLD reset-controller used by emmc
+		 * hw-reset. Keep spi0 and emmc assigned together.
+		 */
+		spi0: spi@b0000 {
+			compatible = "amd,pensando-elba-spi";
+			reg = <0x0 0xb0000 0x0 0x100>;
+			amd,pensando-elba-syscon = <&syscon>;
+			clocks = <&ahb_clk>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 12 4>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			num-cs = <4>;
+			status = "okay";
+			xen,reg = <0x0 0xb0000 0x0 0x1000 0x0 0xb0000>;
+			xen,path = "/soc/spi@b0000";
+			xen,force-assign-without-iommu;
+
+			spi@0 {
+				compatible = "amd,pensando-cpld-spimux";
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				cs0 = <&spi0 0>;
+				cs1 = <&spi0 1>;
+
+				spi@0 {
+					compatible = "amd,pensando-elbasr", "simple-mfd";
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+					spi-max-frequency = <5000000>;
+
+					rstc: reset-controller@0 {
+						compatible = "amd,pensando-elbasr-reset";
+						reg = <0>;
+						spi-reset-frequency = <500000>;
+						#reset-cells = <1>;
+					};
+				};
+
+				spi@1 {
+					compatible = "amd,pensando-elbasr", "simple-mfd";
+					reg = <1>;
+					spi-max-frequency = <5000000>;
+				};
+
+				spi@2 {
+					compatible = "amd,pensando-cpld-rd1173";
+					reg = <2>;
+					spi-max-frequency = <12000000>;
+					/*
+					 * Match the native Salina DT
+					 * (salina-n1-common.dtsi): the rd1173 driver
+					 * prefers the gpiod path (interrupt-gpios),
+					 * which calls gpiod_direction_input() to put
+					 * the CPLD interrupt line in input mode. Without
+					 * it the driver falls back to the raw spi->irq
+					 * and the completion IRQ never fires. 1 =
+					 * GPIO_ACTIVE_LOW; 8 = IRQ_TYPE_LEVEL_LOW.
+					 */
+					interrupt-gpios = <&porta 0 1>;
+					interrupt-parent = <&porta>;
+					interrupts = <0 8>;
+					/*
+					 * The smartnic domain owns all transceiver
+					 * I2C: rd1173 i2c0/i2c1 become /dev/i2c-3 and
+					 * /dev/i2c-4 (native parity). Requires the
+					 * gpio@d0000 parent to route GIC SPI-2 to this
+					 * domain (see interrupts there) so this node's
+					 * completion IRQ (gpiod on porta line 0) fires;
+					 * without it probe fails at gpiod_to_irq.
+					 */
+					status = "okay";
+				};
+
+				spi@3 {
+					compatible = "amd,pensando-elbasr", "simple-mfd";
+					reg = <3>;
+					spi-max-frequency = <12000000>;
+				};
+			};
+		};
+
+		gpio0: gpio@d0000 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			compatible = "snps,dw-apb-gpio";
+			reg = <0x0 0xd0000 0x0 0x78>;
+			status = "okay";
+			xen,reg = <0x0 0xd0000 0x0 0x1000 0x0 0xd0000>;
+			xen,path = "/soc/gpio@d0000";
+			xen,force-assign-without-iommu;
+			/*
+			 * Route GIC SPI-2 to this domain. Xen's
+			 * map_device_irqs_to_domain() reads interrupts only
+			 * from the xen,path node (dt_number_of_irq(node), no
+			 * recursion into children), so the porta child's IRQ
+			 * is invisible to it. Declaring it here routes the
+			 * physical SPI to the guest vGIC; Linux's dwapb driver
+			 * still takes its IRQ from the porta child below. This
+			 * is what feeds the cpld-rd1173 completion IRQ
+			 * (native: gpio-dwapb line 0 -> virq "cpld-rd1173").
+			 */
+			interrupts = <0 2 4>;
+			interrupt-parent = <&gic>;
+
+			porta: gpio-controller@0 {
+				compatible = "snps,dw-apb-gpio-port";
+				reg = <0>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				ngpios = <8>;
+				interrupts = <0 2 4>;
+				interrupt-controller;
+				interrupt-parent = <&gic>;
+				#interrupt-cells = <2>;
+			};
+
+			portb: gpio-controller@1 {
+				compatible = "snps,dw-apb-gpio-port";
+				reg = <1>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				ngpios = <8>;
+			};
+		};
+
+		i2c2: i2c@30000 {
+			compatible = "snps,designware-i2c";
+			reg = <0x0 0x30000 0x0 0x100>;
+			clocks = <&ahb_clk>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			i2c-sda-hold-time-ns = <480>;
+			snps,sda-timeout-ms = <750>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 9 4>;
+			status = "okay";
+			clock-frequency = <100000>;
+			xen,reg = <0x0 0x30000 0x0 0x1000 0x0 0x30000>;
+			xen,path = "/soc/i2c@30000";
+			xen,force-assign-without-iommu;
+
+			temp-sensor@4c {
+				compatible = "ti,tmp451";
+				reg = <0x4c>;
+			};
+
+			ina3221@43 {
+				compatible = "ti,ina3221";
+				reg = <0x43>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				input@0 {
+					reg = <0>;
+					label = "P12VDIN";
+					shunt-resistor-micro-ohms = <2000>;
+				};
+
+				input@1 {
+					reg = <1>;
+					label = "V33";
+					shunt-resistor-micro-ohms = <1000>;
+				};
+
+				input@2 {
+					reg = <2>;
+					label = "VDDR";
+					shunt-resistor-micro-ohms = <1000>;
+				};
+			};
+
+			rtc@51 {
+				compatible = "nxp,pcf85263";
+				reg = <0x51>;
+			};
+
+			regulator@60 {
+				compatible = "ti,tps53659";
+				reg = <0x60>;
+			};
+		};
+
+		/*
+		 * MCTP bus (-> Linux /dev/i2c-2). Mirrors native bare-metal
+		 * (salina-asic-common.dtsi &i2c3): controller + mctp@32 endpoint
+		 * child so mctp-i2c-interface instantiates (native: 2-1032).
+		 * All I2C is owned by the smartnic domain; hostnic is isolated.
+		 */
+		i2c3: i2c@40000 {
+			compatible = "snps,designware-i2c";
+			reg = <0x0 0x40000 0x0 0x100>;
+			clocks = <&ahb_clk>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			i2c-sda-hold-time-ns = <480>;
+			snps,sda-timeout-ms = <750>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 10 4>;
+			status = "okay";
+			clock-frequency = <100000>;
+			multi-master;
+			mctp-controller;
+			xen,reg = <0x0 0x40000 0x0 0x1000 0x0 0x40000>;
+			xen,path = "/soc/i2c@40000";
+			xen,force-assign-without-iommu;
+
+			mctp@32 {
+				compatible = "mctp-i2c-controller";
+				/* 0x32 | I2C_OWN_SLAVE_ADDRESS (1 << 30); renders as 2-1032 */
+				reg = <0x40000032>;
+			};
+		};
+
+		wdt0: watchdog@50000 {
+			compatible = "snps,dw-wdt";
+			reg = <0x0 0x50000 0x0 0x100>;
+			clocks = <&ahb_clk>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 13 4>;
+			status = "okay";
+			xen,reg = <0x0 0x50000 0x0 0x1000 0x0 0x50000>;
+			xen,path = "/soc/watchdog@50000";
+			xen,force-assign-without-iommu;
+		};
+
+		edac: edac@42c00000 {
+			compatible = "pensando,salina-edac-mc";
+			reg = <0x0 0x42c00000 0x0 0x100000>,
+			      <0x0 0x42d00000 0x0 0x100000>,
+			      <0x0 0x30000000 0x0 0x100000>,
+			      <0x0 0x30100000 0x0 0x100000>;
+			status = "okay";
+			xen,reg = <0x0 0x42c00000 0x0 0x100000 0x0 0x42c00000>,
+				  <0x0 0x42d00000 0x0 0x100000 0x0 0x42d00000>,
+				  <0x0 0x30000000 0x0 0x100000 0x0 0x30000000>,
+				  <0x0 0x30100000 0x0 0x100000 0x0 0x30100000>;
+			xen,path = "/soc/edac@42c00000";
+			xen,force-assign-without-iommu;
+		};
+
+		stmmac_axi_setup: stmmac-axi-config {
+			snps,wr_osr_lmt = <0>;
+			snps,rd_osr_lmt = <0>;
+			snps,blen = <0 0 0 0 0 4 0>;
+		};
+
+		gmac0: ethernet@6d73a000 {
+			compatible = "snps,dwmac-3.70a", "snps,dwmac";
+			reg = <0x0 0x6d73a000 0x0 0x8000>;
+			clocks = <&gmac_clk>;
+			clock-names = "stmmaceth";
+			interrupt-parent = <&gic>;
+			interrupts = <0 57 4>;
+			interrupt-names = "macirq";
+			mac-address = [00 00 00 00 00 00];/* Filled in by U-Boot */
+			max-frame-size = <3800>;
+			phy-mode = "gmii";
+			snps,fixed-burst;
+			snps,multicast-filter-bins = <256>;
+			snps,perfect-filter-entries = <128>;
+			rx-fifo-depth = <16384>;
+			tx-fifo-depth = <16384>;
+			snps,axi-config = <&stmmac_axi_setup>;
+			snps,pbl = <2>;
+			xen,reg = <0x0 0x6d73a000 0x0 0x8000 0x0 0x6d73a000>;
+			xen,path = "/soc/ethernet@6d73a000";
+			xen,force-assign-without-iommu;
+			fixed-link {
+				speed = <1000>;
+				full-duplex;
+			};
+		};
+
+		/*
+		 * emmc needs spi0 (reset-controller) access. If spi0 and emmc are
+		 * not assigned together, remove cap-mmc-hw-reset, reset-names, resets.
+		 * (Elba: mmc@30440000 -> Salina: sdio-host-chip@600000)
+		 */
+		emmc: sdio-host-chip@600000 {
+			compatible = "amd,pensando-salina-sd4hc", "cdns,sd4hc";
+			clocks = <&emmc_clk>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 51 4>;
+			reg = <0x0 0x600000 0x0 0x10000>,
+			      <0x0 0x680044 0x0 0x4>;
+			mmc-ddr-1_8v;
+			mmc-hs200-1_8v;
+			mmc-hs400-1_8v;
+			mmc-hs400-enhanced-strobe;
+			cdns,phy-input-delay-sd-highspeed = <0x4>;
+			cdns,phy-input-delay-legacy = <0x4>;
+			cdns,phy-input-delay-mmc-ddr = <0x8>;
+			cdns,phy-input-delay-sd-uhs-sdr50 = <0x6>;
+			cdns,phy-input-delay-sd-uhs-ddr50 = <0x16>;
+			cdns,phy-dll-delay-sdclk = <0x2f>;
+			bus-width = <8>;
+			cap-mmc-hw-reset;
+			reset-names = "hw";
+			resets = <&rstc 0>;
+			status = "okay";
+			xen,reg = <0x0 0x600000 0x0 0x10000 0x0 0x600000>,
+				  <0x0 0x680000 0x0 0x1000 0x0 0x680000>;
+			xen,path = "/soc/sdio-host-chip@600000";
+			xen,force-assign-without-iommu;
+		};
+
+		qspi1: spi@a0000 {
+			compatible = "amd,pensando-salina-qspi", "cdns,qspi-nor";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0x0 0xa0000 0x0 0x400>,
+			      <0x0 0x7fff0000 0x0 0x1000>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 1 4>;
+			clocks = <&flash_clk>;
+			cdns,fifo-depth = <1024>;
+			cdns,fifo-width = <4>;
+			cdns,trigger-address = <0x07ff0000>;
+			status = "okay";
+
+			xen,reg = <0x0 0xa0000 0x0 0x1000 0x0 0xa0000>,
+				  <0x0 0x7fff0000 0x0 0x1000 0x0 0x7fff0000>;
+			xen,path = "/soc/spi@a0000";
+			xen,force-assign-without-iommu;
+
+			flash0: flash@0 {
+				compatible = "jedec,spi-nor";
+				reg = <0>;
+				spi-max-frequency = <40000000>;
+				spi-rx-bus-width = <2>;
+				m25p,fast-read;
+				cdns,read-delay = <6>;
+				cdns,tshsl-ns = <200>;
+				cdns,tsd2d-ns = <0>;
+				cdns,tchsh-ns = <0>;
+				cdns,tslch-ns = <0>;
+				write-block-size = <1024>;
+				erase-block-size = <4096>;
+			};
+		};
+
+		/* bsm (Salina: bsm@6100020c inside syscon page @61000000) */
+		bsm@6100020c {
+			compatible = "pensando,bsm";
+			reg = <0x0 0x6100020c 0x0 0x4>;
+			/* Register is already mapped by the syscon@61000000 passthrough
+			 * above, so use an empty xen,reg (node-assign only, no MMIO map).
+			 * Xen requires xen,reg to be present whenever xen,path is
+			 * (dom0less-build.c:367/377), same as gpio-controller@0.
+			 */
+			xen,reg;
+			xen,path = "/soc/bsm@6100020c";
+			xen,force-assign-without-iommu;
+		};
+
+		rstcause {
+			compatible = "pensando,rstcause";
+			pensando,causeregs = <&syscon 0x204>;
+		};
+	};
+};
