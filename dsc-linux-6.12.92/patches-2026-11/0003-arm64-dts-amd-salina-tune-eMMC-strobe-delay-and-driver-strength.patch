From 091a7a473b7abc5c771ae73be0f0ac853b3d8e3e Mon Sep 17 00:00:00 2001
From: Brad Larson <bradley.larson@amd.com>
Date: Mon, 26 Oct 2026 13:27:30 -0700
Subject: [PATCH] arm64: dts: amd: salina: tune eMMC strobe delay and driver
 strength

On some boots at the high-voltage corner, eMMC initialisation fails
with:

  mmc0: error -84 whilst initialising MMC card

The core then resets the card, and the second attempt brings it up in
HS400ES.

Set the Cadence SD4HC PHY DLL strobe delay to 0x0c and the eMMC driver
type to 1 so the first initialisation succeeds. The settings apply to
all qualified eMMC vendors.

Mark the device non-removable: it is soldered down and has no card
detect.

Tested on Leni boards with WDC, Phison and Kingston eMMC devices.
The cards run at HS400 enhanced strobe, 200 MHz, 8-bit.

Signed-off-by: Brad Larson <bradley.larson@amd.com>
Signed-off-by: rahshekh <rahulshekhar@pensando.io>
---
 arch/arm64/boot/dts/amd/salina-asic-common.dtsi | 2 ++
 arch/arm64/boot/dts/amd/salina-asic.dtsi        | 1 +
 2 files changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/amd/salina-asic-common.dtsi b/arch/arm64/boot/dts/amd/salina-asic-common.dtsi
index 2b972e01889d..110fb874dd88 100644
--- a/arch/arm64/boot/dts/amd/salina-asic-common.dtsi
+++ b/arch/arm64/boot/dts/amd/salina-asic-common.dtsi
@@ -22,6 +22,8 @@ &emmc_clk {
 &emmc0 {
 	bus-width = <8>;
 	cap-mmc-hw-reset;
+	non-removable;
+	fixed-emmc-driver-type = <1>;
 	reset-names = "hw";
 	resets = <&rstc EMMC_HW_RESET>;
 	status = "ok";
diff --git a/arch/arm64/boot/dts/amd/salina-asic.dtsi b/arch/arm64/boot/dts/amd/salina-asic.dtsi
index f11bf1b8d1ba..0b0ed60e7491 100644
--- a/arch/arm64/boot/dts/amd/salina-asic.dtsi
+++ b/arch/arm64/boot/dts/amd/salina-asic.dtsi
@@ -234,6 +234,7 @@ emmc0: sdio-host-chip@600000 {
 			cdns,phy-input-delay-sd-uhs-sdr50 = <0x6>;
 			cdns,phy-input-delay-sd-uhs-ddr50 = <0x16>;
 			cdns,phy-dll-delay-sdclk = <0x2f>;
+			cdns,phy-dll-delay-strobe = <0x0c>;
 			status = "disabled";
 		};
 
