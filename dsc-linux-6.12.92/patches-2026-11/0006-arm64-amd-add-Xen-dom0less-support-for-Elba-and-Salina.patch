diff --git a/arch/arm64/boot/dts/amd/Makefile b/arch/arm64/boot/dts/amd/Makefile
index 001d6ce70878..e73ef862a8e3 100644
--- a/arch/arm64/boot/dts/amd/Makefile
+++ b/arch/arm64/boot/dts/amd/Makefile
@@ -3,7 +3,10 @@ dtb-$(CONFIG_ARCH_PENSANDO) += elba-asic.dtb \
 			       elba-asic-psci.dtb \
 			       elba-secure.dtb \
 			       elba-asic-psci-flash128.dtb \
-			       elba-asic-flash128.dtb
+			       elba-asic-flash128.dtb \
+			       elba-asic-xen.dtb \
+			       elba-asic-smartnic.dtb \
+			       elba-asic-hostnic.dtb
 dtb-$(CONFIG_ARCH_PENSANDO_GIGLIO_SOC) += giglio-asic.dtb \
 					  giglio-asic-psci.dtb \
 					  giglio-asic-psci-flash128.dtb \
@@ -15,5 +18,16 @@ dtb-$(CONFIG_ARCH_PENSANDO_SALINA_SOC) += salina-asic.dtb \
 					  salina-haps-16core.dtb \
 					  salina-a35-haps.dtb \
 					  salina-asic-psci.dtb \
+					  salina-asic-xen.dtb \
+					  salina-asic-smartnic.dtb \
+					  salina-asic-hostnic.dtb \
 					  salina-secure.dtb
 dtb-$(CONFIG_ARCH_SEATTLE) += amd-overdrive-rev-b0.dtb amd-overdrive-rev-b1.dtb
+
+# Xen dom0less guest fragments: msi-parent targets the vITS node that Xen
+# generates with the fixed phandle GUEST_PHANDLE_ITS (0xfdea), which cannot be
+# declared in the fragment (Xen rejects fragment phandles >= 65000).
+DTC_FLAGS_elba-asic-smartnic := -Wno-msi_parent_property
+DTC_FLAGS_elba-asic-hostnic := -Wno-msi_parent_property
+DTC_FLAGS_salina-asic-smartnic := -Wno-msi_parent_property
+DTC_FLAGS_salina-asic-hostnic := -Wno-msi_parent_property
diff --git a/arch/arm64/boot/dts/amd/elba-asic-hostnic.dts b/arch/arm64/boot/dts/amd/elba-asic-hostnic.dts
new file mode 100644
index 000000000000..d195525d4e26
--- /dev/null
+++ b/arch/arm64/boot/dts/amd/elba-asic-hostnic.dts
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/dts-v1/;
+/* HostNIC */
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	gic: gic {
+		/* Dummy gic node, only used for phandle reference.
+		 * Xen will populate real vGIC node.
+		 */
+		#interrupt-cells = <3>;
+		interrupt-controller;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		mnet_reserved: mnet_dma_region {
+			compatible = "shared-dma-pool";
+			no-map;
+			size = <0x0 0x6000000>;
+			alignment = <0x0 0x1000>;
+		};
+	};
+
+	passthrough {
+		compatible = "simple-bus";
+		ranges;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		dma-coherent;
+
+		ahb_clk: oscillator0 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		emmc_clk: oscillator2 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <200000000>;
+		};
+
+		flash_clk: oscillator3 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		ref_clk: oscillator4 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <156250000>;
+		};
+
+		gmac_clk: oscillator5 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <250000000>;
+		};
+
+		mnet0: mnet0 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x0>;
+			memory-region = <&mnet_reserved>;
+		};
+
+		/*
+		 * Ranges to be made accessible in SoC for HostNIC.
+		 * Per memory layout the following range should be accessible:
+		 *
+		 * 0x20000000-0x2037FFFF  PCIe
+		 * 0x10000000-0x11FFFFFF  Doorbell                    # disjoint from SmartNIC
+		 * 0x60600000-0x60600FFF  Host Cache Invalidation RXDMA Register
+		 * 0x60701000-0x60701FFF  RXDMA Cache Invalidation Register
+		 * 0x60f01000-0x60F01FFF  P4I Cache Invalidation Register
+		 * 0x61701000-0x61701FFF  P4E Cache Invalidation Register
+		 * 0x12701000-0x12701FFF  TXDMA Cache Invalidation Register
+		 * 0x12a01000-0x12a01FFF  SXDMA Cache Invalidation Register
+		 * 0x0084400000-0x00bFFFFFFF DDR - Cache Coherent - Linux # disjoint from SmartNIC
+		 * 0x00C4000000-0x01FFFFFFFF DDR-DataPlane            # disjoint from SmartNIC
+		 * 0x0400000000-0x04003FFFFF DM                       # disjoint from SmartNIC
+		 * 0x1000000000-0x107FFFFFFF DDR-Bypass               # disjoint from SmartNIC
+		 * 0x1200000000-0x123FFFFFFF DDR-Hi                   # disjoint from SmartNIC
+		 * 0x1240000000-0x17FFFFFFFF DDR - Cache Coherent - Linux # disjoint from SmartNIC
+		 */
+		capmem {
+			compatible = "pensando,capmem";
+			pensando,capmem-fixed-ranges =
+				/*
+				 * Device register windows, split to exclude the physical
+				 * GIC block (GICD/ITS 0x800000, GICR 0xa00000, end 0xbfffff)
+				 * and GICC CPU interfaces at 0x60000000-0x60001fff.
+				 * Direct-mapping the GIC bypasses Xen's vGIC/vITS and
+				 * exposes host interrupt state to the guest.
+				 */
+				<0x0 0x200000  0x0 0x600000   0x4>,   /* 0x200000-0x7fffff (before GICD) */
+				<0x0 0xc00000  0x0 0x5f400000 0x4>,   /* 0xc00000-0x5fffffff (after GICR) */
+				<0x0 0x60002000 0x0 0xfffe000 0x4>,   /* 0x60002000-0x6fffffff (after GICC) */
+				/* Maps range 0x400000000-0x4003fffff as Device Memory */
+				<0x4 0x0 0x0 0x400000 0x4>;
+			pensando,capmem-ranges =
+				/* Maps 0x00c0000000-0x0c3ffffff  as Coherent */
+				<0x00000000 0xc0000000 0x00000000 0x04000000 0x00000001>,
+				/* Maps 0x00c4000000-0x1ffffffff as Non-coherent */
+				<0x00000000 0xc4000000 0x00000001 0x3c000000 0x00000000>,
+				/* Maps 0x1000000000-0x107fffffff as Bypass */
+				<0x00000010 0x00000000 0x00000000 0x80000000 0x00000002>,
+				/* Maps 0x1200000000-0x127fffffff as Non-coherent */
+				<0x00000012 0x00000000 0x00000000 0x80000000 0x00000000>;
+		};
+
+		uio_penmsi1@520000 {
+			compatible = "pensando,uio_penmsi1";
+			reg = <0x0 0x520000 0x0 0x10000>;
+			msi-parent = <0xfdea 0xa>; /* hardcoded ITS phandle, no &its label */
+			num-interrupts = <32>;
+			xen,reg = <0x0 0x520000 0x0 0x10000 0x0 0x520000>;
+			xen,path = "/soc/uio_penmsi1@520000";
+			xen,force-assign-without-iommu;
+		};
+
+		/* Group: pxc0_intr, pciemac, pcie, kpcimgr */
+		pxc0_intr: interrupt-controller@20102200 {
+			compatible = "pensando,soc-ictlr-csrintr";
+			interrupt-controller;
+			reg = <0x0 0x20102200 0x0 0x4>;
+			#interrupt-cells = <3>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 17 4>;
+			interrupt-names = "pxc0_intr";
+			xen,reg = <0x0 0x20102000 0x0 0x1000 0x0 0x20102000>; /* 4k page */
+			xen,path = "/soc/interrupt-controller@20102200";
+			xen,force-assign-without-iommu;
+		};
+
+		/* pxc0_intr and pciemac@20102200 duplicate reg base (but different size) */
+		pciemac@20102200 {
+			#address-cells = <2>;
+			#size-cells = <2>;
+
+			compatible = "pensando,uio_pciemac";
+			register-type = "csr-interrupt";
+			interrupt-parent = <&pxc0_intr>;
+			interrupts = <0 0 4>;
+			reg = <0x0 0x20102200 0x0 0x10>;
+
+			enable_csr_paddr = <0x0 0x20102200 0x0 0x10>;
+			enable_mask = <(1 << 0)>;
+
+			/* same 4k page as pxc0_intr */
+			xen,reg = <0x0 0x20102000 0x0 0x1000 0x0 0x20102000>;
+			xen,path = "/soc/pciemac@20102200";
+			xen,force-assign-without-iommu;
+		};
+
+		/*
+		 * Caution: wdt0 (watchdog@1400), wdt1 (watchdog@1800),
+		 * wdt2 (watchdog@1c00) and pcie@307c2480 share a page.
+		 * Caution: bsm@307c2080, pcie@307c2480, sbus@307c24a8,
+		 * sbus@307c24b8 and sbus@307c24c8 share a page.
+		 */
+		pcie@307c2480 {
+			compatible = "pensando,pcie";
+			reg = <0x0 0x307c2480 0x0 0x4>,
+				  <0x0 0x1400 0x0 0x10>,
+				  <0x0 0x20000000 0x0 0x380000>;
+
+			xen,reg = <0x0 0x307c2000 0x0 0x1000 0x0 0x307c2000>, /* 4k page */
+				  <0x0 0x1000 0x0 0x1000 0x0 0x1000>, /* 4k page */
+				  <0x0 0x20000000 0x0 0x380000 0x0 0x20000000>;
+			xen,path = "/soc/pcie@307c2480";
+			xen,force-assign-without-iommu;
+		};
+
+		kpcimgr@20000000 {
+			compatible = "pensando,kpcimgr";
+			msi-parent = <0xfdea 0x1f>; /* hardcoded ITS phandle, no &its label */
+			shmem-index = <3>;
+			hwmem-index = <2>;
+			dynevq-index = <4>;
+			reg = <0x0 0x20000000 0x0 0x00380000>,
+				  <0x0 0x61800000 0x0 0x00101000>,
+				  <0x0 0xc4000000 0x0 0x01000000>,
+				  <0x0 0x0 0x0 0x02000000>,
+				  <0x0 0xc0000000 0x0 0x00800000>;
+
+			xen,reg = <0x0 0x20000000 0x0 0x00380000 0x0 0x20000000>,
+				  <0x0 0x61800000 0x0 0x00101000 0x0 0x61800000>,
+				  <0x0 0xc0000000 0x0 0x00800000 0x0 0xc0000000>;
+				  /* <0x0 0x0 0x0 0x02000000 0x0 0x0>; */
+				  /* Linux hangs with this last mapping enabled, due
+				   * to overlap with vPL011 mmio. This overlaps with
+				   * all the low peripherals!
+				   */
+			xen,path = "/soc/kpcimgr@20000000";
+			xen,force-assign-without-iommu;
+		};
+
+		captun {
+			compatible = "oracle,captun";
+			shared_mem = <0x0 0xc5ff7000>;
+			shared_size = <0x0 0x8000>;
+			endpoint_addr = "169.254.1.200";
+			local_addr = "169.254.1.100";
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/amd/elba-asic-smartnic.dts b/arch/arm64/boot/dts/amd/elba-asic-smartnic.dts
new file mode 100644
index 000000000000..7257ad72c5a5
--- /dev/null
+++ b/arch/arm64/boot/dts/amd/elba-asic-smartnic.dts
@@ -0,0 +1,600 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (c) 2019-2021, Pensando Systems Inc. */
+
+/dts-v1/;
+/* SmartNIC */
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		spi0 = &spi0;
+		spi1 = &qspi;
+	};
+
+	gic: gic {
+		/* Dummy gic node, only used for phandle reference.
+		 * Xen will populate real vGIC node.
+		 */
+		#interrupt-cells = <3>;
+		interrupt-controller;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		mnet_reserved: mnet_dma_region {
+			compatible = "shared-dma-pool";
+			no-map;
+			size = <0x0 0x6000000>;
+			alignment = <0x0 0x1000>;
+		};
+	};
+
+	passthrough {
+		compatible = "simple-bus";
+		ranges;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		dma-coherent;
+
+		ahb_clk: oscillator0 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		emmc_clk: oscillator2 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <200000000>;
+		};
+
+		flash_clk: oscillator3 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <400000000>;
+		};
+
+		ref_clk: oscillator4 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <156250000>;
+		};
+
+		gmac_clk: oscillator5 {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <250000000>;
+		};
+
+		capmem {
+			compatible = "pensando,capmem";
+			pensando,capmem-fixed-ranges =
+				/*
+				 * Device register windows, split to exclude the physical
+				 * GIC block (GICD/ITS 0x800000, GICR 0xa00000, end 0xbfffff)
+				 * and GICC CPU interfaces at 0x60000000-0x60001fff.
+				 * Direct-mapping the GIC bypasses Xen's vGIC/vITS and
+				 * exposes host interrupt state to the guest.
+				 */
+				<0x0 0x200000  0x0 0x600000   0x4>,   /* 0x200000-0x7fffff (before GICD) */
+				<0x0 0xc00000  0x0 0x5f400000 0x4>,   /* 0xc00000-0x5fffffff (after GICR) */
+				<0x0 0x60002000 0x0 0xfffe000 0x4>,   /* 0x60002000-0x6fffffff (after GICC) */
+				/* inb_mnic0 debug */
+				<0x00 0x80000000 0x00 0x4000000 0x01>,
+				/* Maps range 0x400000000-0x4003fffff as Device Memory */
+				<0x4 0x0 0x0 0x400000 0x4>;
+			pensando,capmem-ranges =
+				/* Maps 0x00c0000000-0x0c3ffffff  as Coherent */
+				<0x00000000 0xc0000000 0x00000000 0x04000000 0x00000001>,
+				/* Maps 0x00c4000000-0x1ffffffff as Non-coherent */
+				<0x00000000 0xc4000000 0x00000001 0x3c000000 0x00000000>,
+				/* Maps 0x1000000000-0x107fffffff as Bypass */
+				<0x00000010 0x00000000 0x00000000 0x80000000 0x00000002>,
+				/* Maps 0x1200000000-0x127fffffff as Non-coherent */
+				<0x00000012 0x00000000 0x00000000 0x80000000 0x00000000>;
+		};
+
+		/*
+		 * Caution: bsm@307c2080, pcie@307c2480, sbus@307c24a8,
+		 * sbus@307c24b8 and sbus@307c24c8 share a page.
+		 */
+		sbus@307c24a8 {
+			compatible = "pensando,sbus";
+			sbus-ring-num = <0>;
+			reg = <0x0 0x307c24a8 0x0 0x8>;
+			/* 4k page shared with pcie@307c2480 */
+			xen,reg = <0x0 0x307c2000 0x0 0x1000 0x0 0x307c2000>;
+			xen,path = "/soc/sbus@307c24a8";
+			xen,force-assign-without-iommu;
+		};
+
+		/*
+		 * Caution: bsm@307c2080, pcie@307c2480, sbus@307c24a8,
+		 * sbus@307c24b8 and sbus@307c24c8 share a page.
+		 */
+		sbus@307c24b8 {
+			compatible = "pensando,sbus";
+			sbus-ring-num = <1>;
+			reg = <0x0 0x307c24b8 0x0 0x8>;
+			/* 4k page shared with pcie@307c2480 */
+			xen,reg = <0x0 0x307c2000 0x0 0x1000 0x0 0x307c2000>;
+			xen,path = "/soc/sbus@307c24b8";
+			xen,force-assign-without-iommu;
+		};
+
+		/*
+		 * Caution: bsm@307c2080, pcie@307c2480, sbus@307c24a8,
+		 * sbus@307c24b8 and sbus@307c24c8 share a page.
+		 */
+		sbus@307c24c8 {
+			compatible = "pensando,sbus";
+			sbus-ring-num = <2>;
+			reg = <0x0 0x307c24c8 0x0 0x8>;
+			/* 4k page shared with pcie@307c2480 */
+			xen,reg = <0x0 0x307c2000 0x0 0x1000 0x0 0x307c2000>;
+			xen,path = "/soc/sbus@307c24c8";
+			xen,force-assign-without-iommu;
+		};
+
+		sbus@6f242134 {
+			compatible = "pensando,sbus";
+			sbus-ring-num = <3>;
+			reg = <0x0 0x6f242134 0x0 0x8>;
+			xen,reg = <0x0 0x6f242000 0x0 0x1000 0x0 0x6f242000>; /* 4k page */
+			xen,path = "/soc/sbus@6f242134";
+			xen,force-assign-without-iommu;
+		};
+
+		mnet0: mnet0 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x0>; /* hardcoded ITS phandle, no &its label */
+			memory-region = <&mnet_reserved>;
+		};
+		mnet1: mnet1 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x1>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet2: mnet2 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x2>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet3: mnet3 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x3>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet4: mnet4 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x4>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet5: mnet5 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x5>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet6: mnet6 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x6>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet7: mnet7 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x7>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet8: mnet8 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x8>;
+			memory-region = <&mnet_reserved>;
+		};
+		mnet9: mnet9 {
+			compatible = "pensando,mnet";
+			msi-parent = <0xfdea 0x9>;
+			memory-region = <&mnet_reserved>;
+		};
+
+		mcrypt0: mcrypt0 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xb>;
+		};
+		mcrypt1: mcrypt1 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xc>;
+		};
+		mcrypt2: mcrypt2 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xd>;
+		};
+		mcrypt3: mcrypt3 {
+			compatible = "pensando,mcrypt";
+			msi-parent = <0xfdea 0xe>;
+		};
+
+		captun {
+			compatible = "oracle,captun";
+			shared_mem = <0x0 0xc5ff7000>;
+			shared_size = <0x0 0x8000>;
+			endpoint_addr = "169.254.1.100";
+			local_addr = "169.254.1.200";
+			initialize = "yes";
+		};
+
+		i2c0: i2c@400 {
+			compatible = "snps,designware-i2c";
+			reg = <0x0 0x400 0x0 0x100>;
+			clocks = <&ahb_clk>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			i2c-sda-hold-time-ns = <480>;
+			snps,sda-timeout-ms = <750>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 4 4>;
+			status = "okay";
+			clock-frequency = <100000>;
+
+			xen,reg = <0x0 0x0 0x0 0x1000 0x0 0x0>; /* 4k page */
+			xen,path = "/soc/i2c@400";
+			xen,force-assign-without-iommu;
+
+			temp-sensor@4c {
+				compatible = "ti,tmp451";
+				reg = <0x4c>;
+			};
+
+			rtc@51 {
+				compatible = "nxp,pcf85263";
+				reg = <0x51>;
+			};
+
+			regulator@62 {
+				compatible = "ti,tps53659";
+				reg = <0x62>;
+			};
+		};
+
+		/*
+		 * Caution: wdt0 (watchdog@1400), wdt1 (watchdog@1800),
+		 * wdt2 (watchdog@1c00) and pcie@307c2480 share a page.
+		 */
+		wdt0: watchdog@1400 {
+			compatible = "snps,dw-wdt";
+			reg = <0x0 0x1400 0x0 0x100>;
+			clocks = <&ahb_clk>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 10 4>;
+			status = "okay";
+			xen,reg = <0x0 0x1000 0x0 0x1000 0x0 0x1000>; /* 4k page */
+			xen,path = "/soc/watchdog@1400";
+			xen,force-assign-without-iommu;
+		};
+
+		/*
+		 * Group: spi0, gpio0, mssoc
+		 * Group must be assigned together to avoid breaking phandle references.
+		 * Caution: wdt3 (watchdog@2000), qspi (spi@2400), and spi0 (spi@2800) share a page
+		 */
+		spi0: spi@2800 {
+			compatible = "amd,pensando-elba-spi";
+			reg = <0x0 0x2800 0x0 0x100>;
+			amd,pensando-elba-syscon = <&mssoc>;
+			/* XXX pensando,spics = <&mssoc 0x2468 0>;*/
+			clocks = <&ahb_clk>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 9 4>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			num-cs = <4>;
+			cs-gpios = <0>, <0>,
+				   <&porta 1 1>, <&porta 7 1>;
+			status = "okay";
+			xen,reg = <0x0 0x2000 0x0 0x1000 0x0 0x2000>; /* 4k page (overlaps qspi) */
+			xen,path = "/soc/spi@2800";
+			xen,force-assign-without-iommu;
+
+			spi@0 {
+				compatible = "amd,pensando-elbasr", "simple-mfd";
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				spi-max-frequency = <12000000>;
+
+				rstc: reset-controller@0 {
+					compatible = "amd,pensando-elbasr-reset";
+					reg = <0>;
+					#reset-cells = <1>;
+				};
+			};
+
+			spi@1 {
+				compatible = "amd,pensando-elbasr", "simple-mfd";
+				reg = <1>;
+				spi-max-frequency = <12000000>;
+			};
+
+			spi@2 {
+				compatible = "amd,pensando-cpld-rd1173";
+				reg = <2>;
+				spi-max-frequency = <12000000>;
+				interrupt-parent = <&porta>;
+				interrupts = <0 8>;
+			};
+
+			spi@3 {
+				compatible = "amd,pensando-elbasr", "simple-mfd";
+				reg = <3>;
+				spi-max-frequency = <12000000>;
+			};
+		};
+
+		/*
+		 * Caution: gpio and uart share a page
+		 * Hack: need to tell vpl011 to use a different IPA to assign gpio
+		 */
+		gpio0: gpio@4000 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			compatible = "snps,dw-apb-gpio";
+			reg = <0x0 0x4000 0x0 0x78>;
+			status = "okay";
+			xen,reg = <0x0 0x4000 0x0 0x1000 0x0 0x4000>; /* 4k page (overlaps uart) */
+			xen,path = "/soc/gpio@4000";
+			xen,force-assign-without-iommu;
+
+			porta: gpio-port@0 {
+				compatible = "snps,dw-apb-gpio-port";
+				reg = <0>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				ngpios = <8>;
+				interrupts = <0 1 4>;
+				interrupt-controller;
+				interrupt-parent = <&gic>;
+				#interrupt-cells = <2>;
+
+				xen,reg; /* Empty xen,reg for mapping interrupt only */
+				xen,path = "/soc/gpio@4000/gpio-port@0";
+				xen,force-assign-without-iommu;
+			};
+
+			portb: gpio-port@1 {
+				compatible = "snps,dw-apb-gpio-port";
+				reg = <1>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				ngpios = <8>;
+			};
+		};
+
+		mssoc: mssoc@307c0000 {
+			compatible = "amd,pensando-elba-syscon", "syscon";
+			reg = <0x0 0x307c0000 0x0 0x3000>;
+			xen,reg = <0x0 0x307c0000 0x0 0x3000 0x0 0x307c0000>;
+			xen,path = "/soc/syscon@307c0000";
+			xen,force-assign-without-iommu;
+		};
+
+		edac: edac@30500000 {
+			compatible = "pensando,elba-edac-mc";
+			reg = <0x0 0x30500000 0x0 0x100000>;
+			status = "okay";
+			xen,reg = <0x0 0x30500000 0x0 0x100000 0x0 0x30500000>;
+			xen,path = "/soc/edac@30500000";
+			xen,force-assign-without-iommu;
+		};
+
+		/*
+		 * group: stmmac_axi_setup, gmac0
+		 * group must be assigned together to avoid breaking phandle references
+		 */
+		stmmac_axi_setup: stmmac-axi-config {
+			snps,wr_osr_lmt = <0xf>;
+			snps,rd_osr_lmt = <0xf>;
+			snps,blen = <256 128 64 32 0 0 0>;
+		};
+
+		gmac0: ethernet@6f21a000 {
+			compatible = "snps,dwmac-3.70a", "snps,dwmac";
+			reg = <0x0 0x6f21a000 0x0 0x8000>;
+			clocks = <&gmac_clk>;
+			clock-names = "stmmaceth";
+			interrupt-parent = <&gic>;
+			interrupts = <0 29 4>;
+			interrupt-names = "macirq";
+			phy-mode = "gmii";
+			mac-address = [00 00 00 00 00 00];/* Filled in by U-Boot */
+			max-frame-size = <3800>;
+			snps,multicast-filter-bins = <256>;
+			snps,perfect-filter-entries = <128>;
+			rx-fifo-depth = <16384>;
+			tx-fifo-depth = <16384>;
+			snps,axi-config = <&stmmac_axi_setup>;
+			snps,pbl = <2>;
+			xen,reg = <0x0 0x6f21a000 0x0 0x8000 0x0 0x6f21a000>;
+			xen,path = "/soc/ethernet@6f21a000";
+			xen,force-assign-without-iommu;
+			fixed-link {
+				speed = <100>;
+				full-duplex;
+			};
+		};
+
+		/*
+		 * Reset needs spi0 (spi@2800) access. If spi0 and emmc are not
+		 * assigned together, remove cap-mmc-hw-reset, reset-names, and
+		 * resets.
+		 */
+		emmc: mmc@30440000 {
+			compatible = "amd,pensando-elba-sd4hc", "cdns,sd4hc";
+			clocks = <&emmc_clk>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 26 4>;
+			reg = <0x0 0x30440000 0x0 0x10000>,
+			      <0x0 0x30480044 0x0 0x4>;
+			cdns,phy-input-delay-sd-highspeed = <0x4>;
+			cdns,phy-input-delay-legacy = <0x4>;
+			cdns,phy-input-delay-sd-uhs-sdr50 = <0x6>;
+			cdns,phy-input-delay-sd-uhs-ddr50 = <0x16>;
+			cdns,phy-dll-delay-sdclk = <0>;
+			cdns,phy-dll-delay-sdclk-hsmmc = <0>;
+			cdns,mmc-ddr-1_8v;
+			bus-width = <8>;
+			cap-mmc-hw-reset;
+			reset-names = "hw";
+			resets = <&rstc 0>;
+			status = "okay";
+			xen,reg = <0x0 0x30440000 0x0 0x10000 0x0 0x30440000>,
+				  <0x0 0x30480000 0x0 0x1000 0x0 0x30480000>; /* 4k page */
+			xen,path = "/soc/mmc@30440000";
+			xen,force-assign-without-iommu;
+		};
+
+		/*
+		 * Caution: wdt3 (watchdog@2000), qspi (spi@2400), and spi0 (spi@2800) share a page
+		 * qspi can still be assigned independently
+		 */
+		qspi: spi@2400 {
+			compatible = "amd,pensando-elba-qspi";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0x0 0x2400 0x0 0x400>,
+			      <0x0 0x7fff0000 0x0 0x1000>;
+			interrupt-parent = <&gic>;
+			interrupts = <0 0 4>;
+			clocks = <&flash_clk>;
+			cdns,fifo-depth = <1024>;
+			cdns,fifo-width = <4>;
+			cdns,trigger-address = <0x7fff0000>;
+			status = "okay";
+
+			xen,reg = <0x0 0x2000 0x0 0x1000 0x0 0x2000>, /* 4k page */
+				  <0x0 0x7fff0000 0x0 0x1000 0x0 0x7fff0000>;
+			xen,path = "/soc/spi@2400";
+			xen,force-assign-without-iommu;
+
+			flash0: flash@0 {
+				compatible = "jedec,spi-nor";
+				reg = <0>;
+				spi-max-frequency = <40000000>;
+				spi-rx-bus-width = <2>;
+				m25p,fast-read;
+				cdns,read-delay = <0>;
+				cdns,tshsl-ns = <0>;
+				cdns,tsd2d-ns = <0>;
+				cdns,tchsh-ns = <0>;
+				cdns,tslch-ns = <0>;
+			};
+		};
+
+		/*
+		 * Caution: bsm@307c2080, pcie@307c2480, sbus@307c24a8,
+		 * sbus@307c24b8 and sbus@307c24c8 share a page.
+		 */
+		bsm@307c2080 {
+			compatible = "pensando,bsm";
+			reg = <0x0 0x307c2080 0x0 0x4>;
+			/* 4k page shared with pcie@307c2480 */
+			xen,reg = <0x0 0x307c2000 0x0 0x1000 0x0 0x307c2000>;
+			xen,path = "/soc/bsm@307c2080";
+			xen,force-assign-without-iommu;
+		};
+
+		rstcause {
+			compatible = "pensando,rstcause";
+			pensando,causeregs = <&mssoc 0x2084>;
+		};
+
+		/* Dependency on qspi */
+		panicdump@740b0000 {
+			compatible = "pensando,capri-crash";
+			reg = <0x0 0x740b0000 0x0 0x20000>;
+			xen,reg = <0x0 0x740b0000 0x0 0x20000 0x0 0x740b0000>;
+			xen,path = "/soc/panicdump@740b0000";
+			xen,force-assign-without-iommu;
+		};
+	};
+};
+
+/include/ "elba-flash-parts-xen.dtsi"
+
+/*
+ * U-Boot fixups
+ *
+ * U-Boot adds/modifies some properties in the device tree. We don't
+ * currently have a clean way to propagate these changes to the partial
+ * device trees. Hardcode the fixups for now.
+ */
+
+/* ft_system_setup() */
+/ {
+	passthrough {
+		dma-coherent;
+	};
+};
+
+&flash0 {
+	spi-max-frequency = <40000000>;
+	cdns,read-delay = <0>;
+};
+
+/* edac_fdt_setup() */
+&edac {
+	pensando,ddrbhash = <0x00 0xfff8100>;
+	pensando,bypass = <0x00 0x80000000 0x00 0x4000000 0x00 0x00 0x00 0x80000000>;
+	pensando,llchash = <0x00 0x400>;
+	pensando,ddrchanmask = <0x03>;
+};
+
+/* pcie_fdt_setup() */
+/ {
+	passthrough {
+		pcie@307c2480 {
+			ports_initialized = <0x1000000>;
+			crs_off_early = <0x00>;
+			clock_freq = <0x4054923d>;
+			presets16gt = <0x00>;
+			cap_width = <0x10000000>;
+			cap_gen = <0x4000000>;
+			pcie_port = <0x00>;
+			/* fwenv_* = ... */
+		};
+	};
+};
+
+/* pcie_swparam_fdt_setup() */
+/ {
+	passthrough {
+		kpcimgr@20000000 {
+			/* reg = ... */
+		};
+	};
+};
+
+/* temp_sensor_fdt_setup() */
+&i2c0 {
+	temp-sensor@4c {
+		compatible = "ti,tmp451";
+		/* compatible = "nxp,sa56004"; */
+		/* compatible = "onnn,nct1008"; */
+	};
+};
+
+/* vrm_sensor_fdt_setup() */
+&i2c0 {
+	regulator@62 {
+		compatible = "ti,tps53659";
+		/* compatible = "lltc,ltc3888"; */
+	};
+};
+
+/* emmc_bypass_setup() */
+&emmc {
+	pensando,bounce-buffer = <0x0 0x80000000 0x0 0x4000000>;
+};
