diff --git a/Documentation/devicetree/bindings/misc/oracle,captun.yaml b/Documentation/devicetree/bindings/misc/oracle,captun.yaml
new file mode 100644
index 000000000000..5edf0636d9f4
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/oracle,captun.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/oracle,captun.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Oracle captun shared-memory tunnel endpoint
+
+maintainers:
+  - Brad Larson <blarson@amd.com>
+
+description: |
+  One endpoint of a point-to-point IP tunnel carried over a shared memory
+  window between two Xen guests on an AMD Pensando DSC. The captun daemon
+  reads this node from /sys/firmware/devicetree/base/passthrough/captun and
+  creates a tun interface with the given addresses. The property names are
+  part of the captun ABI.
+
+properties:
+  compatible:
+    const: oracle,captun
+
+  shared_mem:
+    $ref: /schemas/types.yaml#/definitions/uint64
+    description: Physical address of the shared memory window.
+
+  shared_size:
+    $ref: /schemas/types.yaml#/definitions/uint64
+    description: Size of the shared memory window in bytes.
+
+  local_addr:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: IPv4 address of this end of the tunnel.
+
+  endpoint_addr:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: IPv4 address of the peer end of the tunnel.
+
+  initialize:
+    $ref: /schemas/types.yaml#/definitions/string
+    const: "yes"
+    description:
+      This end initializes the shared memory window. Set on exactly one of
+      the two endpoints.
+
+required:
+  - compatible
+  - shared_mem
+  - shared_size
+  - local_addr
+  - endpoint_addr
+
+additionalProperties: false
+
+examples:
+  - |
+    captun {
+        compatible = "oracle,captun";
+        shared_mem = <0x0 0xc5ff7000>;
+        shared_size = <0x0 0x8000>;
+        endpoint_addr = "169.254.1.100";
+        local_addr = "169.254.1.200";
+        initialize = "yes";
+    };
+
+...
